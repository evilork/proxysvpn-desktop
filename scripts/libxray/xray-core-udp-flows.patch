diff --git a/proxy/tun/udp_flows_proxysvpn_test.go b/proxy/tun/udp_flows_proxysvpn_test.go
new file mode 100644
--- /dev/null
+++ b/proxy/tun/udp_flows_proxysvpn_test.go
@@ -0,0 +1,370 @@
+package tun
+
+// ProxysVPN (scripts/libxray/xray-core-udp-flows.patch). A tester's iPhone,
+// 11.10.2026: with a game open the packet tunnel extension went from 11 to
+// 49.5 MiB in a few minutes on a few kilobytes of traffic, and the system
+// ended it three times. Measured on this engine: one UDP socket of an app
+// that sent a single datagram held 40 to 70 KiB for 300 s, and a stopped
+// engine went on holding it. These tests are the rules that end a flow: how
+// long each kind lives, how many there may be, and that the stack takes its
+// flows with it. scripts/build-libxray.sh runs them on the patched source.
+
+import (
+	"context"
+	"sync/atomic"
+	"testing"
+	"time"
+
+	"github.com/xtls/xray-core/common/net"
+)
+
+// A flow table under test. Its flows are read to their end the way
+// Handler.HandleConnection leaves them to an outbound, and the clock is the
+// test's own.
+type proxysvpnFlows struct {
+	*udpConnectionHandler
+	now atomic.Int64
+	// handlers that have read their flow to its end
+	ended atomic.Int32
+	// when set, a handler returns only after this is closed: an outbound
+	// takes a moment to wind down after its flow has ended
+	linger chan struct{}
+}
+
+func newProxysvpnFlows(limits udpLimits, linger bool) *proxysvpnFlows {
+	f := &proxysvpnFlows{}
+	if linger {
+		f.linger = make(chan struct{})
+	}
+	f.udpConnectionHandler = newUdpConnectionHandler(func(conn net.Conn, _ net.Destination) {
+		defer conn.Close()
+		datagram := make([]byte, 2048)
+		for {
+			if _, err := conn.Read(datagram); err != nil {
+				break
+			}
+		}
+		f.ended.Add(1)
+		if f.linger != nil {
+			<-f.linger
+		}
+	}, func([]byte, net.Destination, net.Destination) error { return nil })
+	f.limits = limits
+	f.clock = func() time.Duration { return time.Duration(f.now.Load()) }
+	return f
+}
+
+// Limits of the device with the sweeper out of the way: these tests move the
+// clock and call expire themselves.
+func proxysvpnLimits() udpLimits {
+	limits := udpDeviceLimits
+	limits.sweepEvery = time.Hour
+	return limits
+}
+
+// Sets the clock, in milliseconds since the table was made.
+func (f *proxysvpnFlows) at(ms int64) {
+	f.now.Store(ms * int64(time.Millisecond))
+}
+
+// A datagram from the app's socket on this port to the far side's port.
+func (f *proxysvpnFlows) send(from, to int) {
+	f.HandlePacket(
+		net.UDPDestination(net.IPAddress([]byte{10, 111, 0, 2}), net.Port(from)),
+		net.UDPDestination(net.IPAddress([]byte{198, 51, 100, 7}), net.Port(to)),
+		[]byte("datagram"),
+	)
+}
+
+func (f *proxysvpnFlows) flow(from int) *udpConn {
+	f.RLock()
+	defer f.RUnlock()
+	return f.udpConns[net.UDPDestination(net.IPAddress([]byte{10, 111, 0, 2}), net.Port(from))]
+}
+
+func (f *proxysvpnFlows) open(t *testing.T, want ...int) {
+	t.Helper()
+	f.RLock()
+	count := len(f.udpConns)
+	f.RUnlock()
+	if count != len(want) {
+		t.Fatalf("%d flows in the table, expected %d (%v)", count, len(want), want)
+	}
+	for _, from := range want {
+		if f.flow(from) == nil {
+			t.Fatalf("the flow from port %d is gone, expected %v", from, want)
+		}
+	}
+}
+
+func (f *proxysvpnFlows) handlers() int {
+	f.RLock()
+	defer f.RUnlock()
+	return f.running
+}
+
+func proxysvpnEventually(t *testing.T, what string, done func() bool) {
+	t.Helper()
+	deadline := time.Now().Add(5 * time.Second)
+	for !done() {
+		if time.Now().After(deadline) {
+			t.Fatal(what)
+		}
+		time.Sleep(time.Millisecond)
+	}
+}
+
+func TestProxysVPNUDPFlowLifetimes(t *testing.T) {
+	f := newProxysvpnFlows(proxysvpnLimits(), false)
+
+	f.at(0)
+	f.send(1001, 53)   // a name query
+	f.send(1002, 7777) // a datagram nobody answers
+	f.send(1003, 7777) // answered once: a probe, not a stream
+	f.send(1004, 7777) // answered, and still talking three seconds later
+	f.at(100)
+	if _, err := f.flow(1003).Write([]byte("answer")); err != nil {
+		t.Fatal(err)
+	}
+	if _, err := f.flow(1004).Write([]byte("answer")); err != nil {
+		t.Fatal(err)
+	}
+	f.at(3000)
+	f.send(1004, 7777)
+
+	steps := []struct {
+		at   int64
+		open []int
+	}{
+		{9900, []int{1001, 1002, 1003, 1004}},
+		{10000, []int{1002, 1003, 1004}}, // the query: 10 s
+		{29900, []int{1002, 1003, 1004}},
+		{30000, []int{1003, 1004}}, // never answered: 30 s
+		{30100, []int{1004}},       // answered once at 0.1 s: 30 s after that
+		{122900, []int{1004}},
+		{123000, nil}, // a stream, last heard at 3 s: 120 s
+	}
+	for _, step := range steps {
+		f.at(step.at)
+		if left := f.expire(); left != (len(step.open) > 0) {
+			t.Fatalf("at %d ms expire reported flows left = %v", step.at, left)
+		}
+		f.open(t, step.open...)
+	}
+	proxysvpnEventually(t, "the handlers of the ended flows did not return", func() bool {
+		return f.ended.Load() == 4 && f.handlers() == 0
+	})
+}
+
+func TestProxysVPNUDPFlowCeilings(t *testing.T) {
+	limits := proxysvpnLimits()
+	limits.maxFlows = 4
+	limits.maxRunning = 6
+	f := newProxysvpnFlows(limits, true)
+
+	f.at(0)
+	f.send(2001, 7777) // a stream by 2.5 s: its end is 122.5 s
+	f.at(100)
+	if _, err := f.flow(2001).Write([]byte("answer")); err != nil {
+		t.Fatal(err)
+	}
+	f.at(2500)
+	f.send(2001, 7777)
+	f.at(3000)
+	f.send(2002, 53) // ends at 13 s
+	f.at(4000)
+	f.send(2003, 7777) // ends at 34 s
+	f.at(5000)
+	f.send(2004, 7777) // ends at 35 s
+	f.open(t, 2001, 2002, 2003, 2004)
+	if queue := cap(f.flow(2001).egress); queue != limits.queue {
+		t.Fatalf("a flow queues %d packets, expected %d", queue, limits.queue)
+	}
+
+	// The table is full: each new flow ends the one nearest to its own end.
+	f.at(6000)
+	f.send(2005, 7777)
+	f.open(t, 2001, 2003, 2004, 2005)
+	f.at(7000)
+	f.send(2006, 7777)
+	f.open(t, 2001, 2004, 2005, 2006)
+	proxysvpnEventually(t, "the two flows that made room were not ended", func() bool { return f.ended.Load() == 2 })
+
+	// Their outbounds are still winding down, so six handlers are alive. A
+	// seventh source is dropped, and it costs nobody a flow.
+	if running := f.handlers(); running != 6 {
+		t.Fatalf("%d handlers alive, expected 6", running)
+	}
+	f.at(8000)
+	f.send(2007, 7777)
+	f.open(t, 2001, 2004, 2005, 2006)
+
+	close(f.linger)
+	proxysvpnEventually(t, "the handlers of the ended flows did not return", func() bool { return f.handlers() == 4 })
+	f.at(9000)
+	f.send(2007, 7777)
+	f.open(t, 2001, 2005, 2006, 2007)
+
+	// What the ceilings are for. A flow towards a node measured 59 to
+	// 70 KiB; the extension has about 39 MiB above its own 11, and the
+	// engine's connections for everything else live there too.
+	const flowCost = 70 << 10
+	if most := udpDeviceLimits.maxRunning * flowCost; most > 14<<20 {
+		t.Fatalf("UDP flows may take %d KiB of the extension's memory, more than 14 MiB", most>>10)
+	}
+	if udpDeviceLimits.maxRunning < udpDeviceLimits.maxFlows {
+		t.Fatal("fewer handlers allowed than flows in the table: a full table could never be reached")
+	}
+}
+
+func TestProxysVPNUDPFlowsEndWithTheStack(t *testing.T) {
+	f := newProxysvpnFlows(proxysvpnLimits(), true)
+
+	f.at(0)
+	f.send(3001, 7777)
+	f.send(3002, 7777)
+	first := f.flow(3001)
+
+	// A flow that timed out is closed once more by its handler, later: by
+	// then the same socket may have a new flow, and that one must stay.
+	f.at(30000)
+	f.expire()
+	f.open(t)
+	f.send(3001, 7777)
+	second := f.flow(3001)
+	if second == nil || second == first {
+		t.Fatal("a socket whose flow timed out did not get a new one")
+	}
+	if err := first.Close(); err != nil {
+		t.Fatal(err)
+	}
+	if f.flow(3001) != second {
+		t.Fatal("closing the old flow took the new one of the same socket out of the table")
+	}
+
+	f.close()
+	f.open(t)
+	close(f.linger)
+	proxysvpnEventually(t, "flows outlived the stack", func() bool {
+		return f.ended.Load() == 3 && f.handlers() == 0
+	})
+
+	// Packets may still arrive while the stack goes away, and an outbound
+	// may still answer a flow that has ended.
+	f.send(3003, 7777)
+	f.open(t)
+	if _, err := second.Write([]byte("late answer")); err != nil {
+		t.Fatal(err)
+	}
+	if err := second.Close(); err != nil {
+		t.Fatal(err)
+	}
+}
+
+// The sweeper on its own clock: nobody calls expire here.
+func TestProxysVPNUDPFlowsEndByThemselves(t *testing.T) {
