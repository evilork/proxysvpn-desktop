+				break
+			}
+		}
+		ended <- struct{}{}
+	}, func([]byte, net.Destination, net.Destination) error { return nil })
+	u.limits.idleNew = 40 * time.Millisecond
+	u.limits.sweepEvery = 5 * time.Millisecond
+
