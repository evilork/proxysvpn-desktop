+// ProxysVPN (scripts/libxray/xray-core-udp-flows.patch). Upstream keeps one
+// flow per UDP source socket of an app and leaves its end to the outbound,
+// which lets go of it after the policy's connIdle: 300 s. A flow is a queue,
+// three goroutines and, towards a node, a connection of its own: 40 to 70 KiB
+// for a socket that sent one datagram. A game that opens a few hundred of
+// them in a minute takes the packet tunnel extension over the 50 MiB the
+// system allows it, and stopping the engine did not end them either.
+//
+// What a flow gets here is what a home router gives it: 30 s while it has
+// only been tried, 120 s once it is a stream, 10 s for a name query. The
+// table has a ceiling, and so has the number of flows still winding down;
+// and a flow that has ended cancels whatever its outbound is still doing a
+// moment later, so a dial that never completes does not wind down for the
+// 80 s its retries would take.
+type udpLimits struct {
+	// packets of one flow waiting for its outbound (upstream: 1024)
+	queue int
+	// idle time allowed to a flow that is not a stream yet
+	idleNew time.Duration
+	// idle time allowed to a stream: answered, and alive for streamAfter
+	idleStream  time.Duration
+	streamAfter time.Duration
+	// idle time allowed to a flow to port 53
+	idleDNS time.Duration
