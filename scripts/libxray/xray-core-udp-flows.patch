+	dst := net.UDPDestination(net.IPAddress([]byte{198, 51, 100, 7}), 7777)
+	idle := func() bool {
+		u.RLock()
+		defer u.RUnlock()
+		return len(u.udpConns) == 0 && u.running == 0 && !u.sweeping
+	}
+	// Twice: the sweeper stops with the last flow and has to come back.
+	for round := 1; round <= 2; round++ {
+		u.HandlePacket(src, dst, []byte("datagram"))
+		select {
+		case <-ended:
+		case <-time.After(5 * time.Second):
+			t.Fatalf("round %d: an idle flow was not ended", round)
+		}
+		proxysvpnEventually(t, "the table did not come to rest", idle)
+	}
+}
+
+// An outbound that never reads its flow, as when the dial to the node does
+// not complete: the end of the flow tells it nothing. What Handler.
+// HandleConnection hands over with onceEnded ends it a moment later, whether
+// the flow ended after the handing over or before it.
+func TestProxysVPNUDPFlowCancelsItsOutbound(t *testing.T) {
+	var now atomic.Int64
+	gate := make(chan struct{})
+	released := make(chan time.Time, 2)
+	u := newUdpConnectionHandler(func(conn net.Conn, _ net.Destination) {
+		defer conn.Close()
+		ctx, cancel := context.WithCancel(context.Background())
+		defer cancel()
+		<-gate
+		conn.(interface{ onceEnded(func()) }).onceEnded(cancel)
+		<-ctx.Done()
+		released <- time.Now()
+	}, func([]byte, net.Destination, net.Destination) error { return nil })
+	u.limits.windDown = 60 * time.Millisecond
+	u.limits.sweepEvery = time.Hour
+	u.clock = func() time.Duration { return time.Duration(now.Load()) }
+
+	dst := net.UDPDestination(net.IPAddress([]byte{198, 51, 100, 7}), 7777)
+	send := func(port int) net.Destination {
+		src := net.UDPDestination(net.IPAddress([]byte{10, 111, 0, 2}), net.Port(port))
+		u.HandlePacket(src, dst, []byte("datagram"))
+		return src
+	}
+	// Ends every flow in the table and says when.
+	end := func() time.Time {
+		now.Add(int64(u.limits.idleNew))
+		u.expire()
+		return time.Now()
+	}
+	expect := func(what string, ended time.Time) {
+		t.Helper()
+		select {
+		case at := <-released:
+			if at.Sub(ended) < u.limits.windDown {
+				t.Fatalf("%s: cancelled %v after its flow ended, before the %v it is given", what, at.Sub(ended), u.limits.windDown)
+			}
+		case <-time.After(5 * time.Second):
+			t.Fatalf("%s: never cancelled", what)
+		}
+	}
+
+	// Handed over first, ended afterwards.
+	src := send(5001)
+	gate <- struct{}{}
+	proxysvpnEventually(t, "the cancel was not handed over", func() bool {
+		u.RLock()
+		defer u.RUnlock()
+		return u.udpConns[src].cancel != nil
+	})
+	select {
+	case <-released:
+		t.Fatal("a flow that is still open was cancelled")
+	case <-time.After(2 * u.limits.windDown):
+	}
+	expect("handed over, then ended", end())
+
+	// Ended first: the handler was not there yet.
+	send(5002)
+	ended := end()
+	gate <- struct{}{}
+	expect("ended, then handed over", ended)
+
+	proxysvpnEventually(t, "the handlers did not return", func() bool {
+		u.RLock()
+		defer u.RUnlock()
+		return u.running == 0
+	})
+}
diff --git a/proxy/tun/udp_flows_restart_proxysvpn_test.go b/proxy/tun/udp_flows_restart_proxysvpn_test.go
new file mode 100644
--- /dev/null
+++ b/proxy/tun/udp_flows_restart_proxysvpn_test.go
@@ -0,0 +1,267 @@
+//go:build darwin
+
+package tun_test
+
+// ProxysVPN (scripts/libxray/xray-core-udp-flows.patch). MemoryGuard.swift
+// restarts the engine in place to get memory back. The UDP flows of the
+// stopped engine used to stay, each with its goroutines and its connection,
+// so the restart freed nothing: a tester's journal of 11.10.2026 reads 47.8,
+// 48.8 and 49.4 MiB across two restarts, and then the system ended the
+// extension. Here apps resolve names through the tunnel from many sockets,
+// the engine is restarted the way the guard does it, and what the first
+// engine held for those sockets has to be gone. The second test is the same
+// with flows whose outbound never got through to its node.
+
+import (
+	"fmt"
+	"net"
+	"runtime"
+	"strings"
+	"sync/atomic"
+	"testing"
+	"time"
+
+	"github.com/xtls/xray-core/core"
+	_ "github.com/xtls/xray-core/main/distro/all"
+	"golang.org/x/sys/unix"
+	"gvisor.dev/gvisor/pkg/tcpip"
+	"gvisor.dev/gvisor/pkg/tcpip/checksum"
+	"gvisor.dev/gvisor/pkg/tcpip/header"
+)
+
+var (
+	proxysvpnFlowApp      = tcpip.AddrFrom4([4]byte{10, 111, 0, 2})
+	proxysvpnFlowResolver = tcpip.AddrFrom4([4]byte{10, 111, 0, 1})
+	proxysvpnFlowServer   = tcpip.AddrFrom4([4]byte{203, 0, 113, 7})
+)
+
+// A datagram from an app's own socket, as the utun hands it over.
+func proxysvpnFlowDatagram(srcPort uint16, dst tcpip.Address, dstPort uint16, payload []byte) []byte {
+	udpLen := header.UDPMinimumSize + len(payload)
+	ipLen := header.IPv4MinimumSize + udpLen
+	p := make([]byte, 4+ipLen)
+	p[3] = unix.AF_INET
+	ip := header.IPv4(p[4:])
+	ip.Encode(&header.IPv4Fields{
+		TotalLength: uint16(ipLen), TTL: 64, Protocol: uint8(header.UDPProtocolNumber),
+		SrcAddr: proxysvpnFlowApp, DstAddr: dst,
+	})
+	ip.SetChecksum(^ip.CalculateChecksum())
+	udp := header.UDP(p[4+header.IPv4MinimumSize:])
+	udp.Encode(&header.UDPFields{SrcPort: srcPort, DstPort: dstPort, Length: uint16(udpLen)})
+	copy(udp.Payload(), payload)
+	sum := header.PseudoHeaderChecksum(header.UDPProtocolNumber, proxysvpnFlowApp, dst, uint16(udpLen))
+	udp.SetChecksum(^udp.CalculateChecksum(checksum.Checksum(payload, sum)))
+	return p
+}
+
+// A query for an A record.
+func proxysvpnFlowQuery(srcPort uint16, name string) []byte {
+	query := []byte{byte(srcPort >> 8), byte(srcPort), 0x01, 0x00, 0, 1, 0, 0, 0, 0, 0, 0}
+	for _, label := range strings.Split(name, ".") {
+		query = append(query, byte(len(label)))
+		query = append(query, label...)
+	}
+	return proxysvpnFlowDatagram(srcPort, proxysvpnFlowResolver, 53, append(query, 0, 0, 1, 0, 1))
+}
+
+// Name handling as the app's configuration has it: queries go to the dns
+// outbound and are answered from the engine's own resolver.
+const proxysvpnFlowNames = `"dns":{"hosts":{"domain:game.test":"198.51.100.9"},"servers":["localhost"],"queryStrategy":"UseIPv4"},
+	"outbounds":[{"protocol":"blackhole","tag":"block"},
+		{"protocol":"dns","tag":"dns-out","settings":{"rules":[{"action":"hijack","qType":"1,28"},{"action":"return","rCode":0}]}}],
+	"routing":{"rules":[{"type":"field","outboundTag":"dns-out","port":53}]}`
+
+// The engine on a duplicate of the tunnel's descriptor; rest is the
+// configuration after the tun inbound.
+func proxysvpnFlowStart(t *testing.T, own int, rest string) *core.Instance {
+	t.Helper()
+	fd, err := unix.Dup(own)
+	if err != nil {
+		t.Fatal(err)
+	}
+	text := fmt.Sprintf(`{"log":{"loglevel":"none"},"env":{"xray.tun.fd":"%d"},
+		"inbounds":[{"tag":"tun-in","protocol":"tun","settings":{"name":"utun","mtu":1500}}],
+		%s}`, fd, rest)
+	config, err := core.LoadConfig("json", strings.NewReader(text))
+	if err != nil {
+		t.Fatal(err)
+	}
+	server, err := core.New(config)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if err := server.Start(); err != nil {
+		t.Fatal(err)
+	}
+	return server
+}
+
+func TestProxysVPNRestartEndsUDPFlows(t *testing.T) {
+	const sockets = 60
+
+	pair, err := unix.Socketpair(unix.AF_UNIX, unix.SOCK_DGRAM, 0)
+	if err != nil {
+		t.Fatal(err)
+	}
+	own, far := pair[0], pair[1]
+	defer unix.Close(own)
+	defer unix.Close(far)
+
+	// The apps' side of the tunnel: counts the answers that come back.
+	var answers atomic.Int32
+	stop := make(chan struct{})
+	drained := make(chan struct{})
+	go func() {
+		defer close(drained)
+		buf := make([]byte, 2048)
+		for {
+			select {
+			case <-stop:
+				return
+			default:
+			}
+			fds := []unix.PollFd{{Fd: int32(far), Events: unix.POLLIN}}
+			if n, _ := unix.Poll(fds, 20); n <= 0 {
+				continue
+			}
+			n, err := unix.Read(far, buf)
+			if err != nil || n < 4+header.IPv4MinimumSize+header.UDPMinimumSize {
+				continue
+			}
+			ip := header.IPv4(buf[4:n])
+			if ip.Protocol() == uint8(header.UDPProtocolNumber) && header.UDP(ip.Payload()).SourcePort() == 53 {
+				answers.Add(1)
+			}
+		}
+	}()
+	defer func() {
+		close(stop)
+		<-drained
+	}()
+
+	first := proxysvpnFlowStart(t, own, proxysvpnFlowNames)
+	time.Sleep(300 * time.Millisecond)
+	rest := runtime.NumGoroutine()
+
+	for i := 0; i < sockets; i++ {
+		port := uint16(30000 + i)
+		unix.Write(far, proxysvpnFlowQuery(port, fmt.Sprintf("n%d.game.test", i)))
+		time.Sleep(time.Millisecond)
+	}
+	deadline := time.Now().Add(5 * time.Second)
+	for answers.Load() < sockets && time.Now().Before(deadline) {
+		time.Sleep(10 * time.Millisecond)
+	}
+	if got := answers.Load(); got < sockets {
+		t.Fatalf("%d of %d name queries were answered through the tunnel", got, sockets)
+	}
+	// Each socket is a flow the engine keeps: without them this test would
+	// pass on an engine that frees nothing.
+	if held := runtime.NumGoroutine(); held < rest+sockets {
+		t.Fatalf("%d goroutines with %d sockets open, %d at rest: the flows are not there to end", held, sockets, rest)
+	}
+
+	if err := first.Close(); err != nil {
+		t.Fatalf("the engine did not stop: %v", err)
+	}
+	second := proxysvpnFlowStart(t, own, proxysvpnFlowNames)
+	defer second.Close()
+
+	deadline = time.Now().Add(5 * time.Second)
+	for runtime.NumGoroutine() >= rest+sockets/2 && time.Now().Before(deadline) {
+		time.Sleep(50 * time.Millisecond)
+	}
+	if left := runtime.NumGoroutine(); left >= rest+sockets/2 {
+		t.Fatalf("%d goroutines after the restart, %d at rest before it: the stopped engine kept its UDP flows", left, rest)
+	}
+}
+
+// A node that takes the connection and never says a word: the dial of every
+// flow stays in its TLS handshake. Nothing reads such a flow, so its end
+// alone ends nothing; it is the cancel a moment later that does, and without
+// it these handlers would stay for as long as the node keeps the connection.
+func TestProxysVPNRestartEndsUDPFlowsThatNeverConnected(t *testing.T) {
+	const sockets = 40
+
+	node, err := net.Listen("tcp", "127.0.0.1:0")
+	if err != nil {
+		t.Fatal(err)
+	}
+	var taken atomic.Int32
+	held := make(chan net.Conn, 16*sockets)
+	go func() {
+		for {
+			conn, err := node.Accept()
+			if err != nil {
+				return
+			}
+			taken.Add(1)
+			select {
+			case held <- conn:
+			default:
+				conn.Close()
+			}
+		}
+	}()
+	defer func() {
+		node.Close()
+		for {
+			select {
+			case conn := <-held:
+				conn.Close()
+			default:
+				return
+			}
+		}
+	}()
+
+	pair, err := unix.Socketpair(unix.AF_UNIX, unix.SOCK_DGRAM, 0)
+	if err != nil {
+		t.Fatal(err)
+	}
+	own, far := pair[0], pair[1]
+	defer unix.Close(own)
+	defer unix.Close(far)
+
+	outbound := fmt.Sprintf(`"outbounds":[{"protocol":"vless","tag":"proxy",
+		"settings":{"vnext":[{"address":"127.0.0.1","port":%d,
+			"users":[{"id":"5783a3e7-e373-51cd-8642-c83782b807c5","encryption":"none"}]}]},
+		"streamSettings":{"network":"tcp","security":"tls","tlsSettings":{"serverName":"node.test"}}}]`,
+		node.Addr().(*net.TCPAddr).Port)
+
+	first := proxysvpnFlowStart(t, own, outbound)
+	time.Sleep(300 * time.Millisecond)
+	rest := runtime.NumGoroutine()
+
+	for i := 0; i < sockets; i++ {
+		unix.Write(far, proxysvpnFlowDatagram(uint16(31000+i), proxysvpnFlowServer, 27015, []byte("ping")))
+		time.Sleep(time.Millisecond)
+	}
+	deadline := time.Now().Add(5 * time.Second)
+	for taken.Load() < sockets && time.Now().Before(deadline) {
+		time.Sleep(10 * time.Millisecond)
+	}
+	if got := taken.Load(); got < sockets {
+		t.Fatalf("%d of %d flows reached the node", got, sockets)
+	}
+	if dialling := runtime.NumGoroutine(); dialling < rest+sockets {
+		t.Fatalf("%d goroutines with %d flows dialling, %d at rest: the flows are not there to end", dialling, sockets, rest)
+	}
+
+	if err := first.Close(); err != nil {
+		t.Fatalf("the engine did not stop: %v", err)
+	}
+	second := proxysvpnFlowStart(t, own, outbound)
+	defer second.Close()
+
+	// Two seconds until the cancel, two more for the retries of the dial to
+	// find out.
+	deadline = time.Now().Add(12 * time.Second)
+	for runtime.NumGoroutine() >= rest+sockets/2 && time.Now().Before(deadline) {
+		time.Sleep(50 * time.Millisecond)
+	}
+	if left := runtime.NumGoroutine(); left >= rest+sockets/2 {
+		t.Fatalf("%d goroutines after the restart, %d at rest before it: flows that never connected were kept", left, rest)
+	}
+}
