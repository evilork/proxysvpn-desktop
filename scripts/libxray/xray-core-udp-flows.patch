+	maxFlows int
+	// flows whose handler has not returned, in the table or out of it;
+	// past this a new source's packet is dropped
+	maxRunning int
+	// what an outbound gets to deliver the answers on their way after its
+	// flow has ended; then its context is cancelled
+	windDown   time.Duration
+	sweepEvery time.Duration
+}
