+// ProxysVPN build: Shadowsocks 2022 is implemented on sagernet/sing
+// (GPL-3.0-or-later), which must not be linked into an App Store binary, so
+// its proxy package is left out and its methods are refused here. The names
+// are the method list sing-shadowsocks exports for it.
+var shadowsocks2022Methods = []string{
+	"2022-blake3-aes-128-gcm",
+	"2022-blake3-aes-256-gcm",
+	"2022-blake3-chacha20-poly1305",
+}
+
+func isShadowsocks2022(method string) bool {
+	for _, m := range shadowsocks2022Methods {
+		if m == method {
+			return true
+		}
+	}
+	return false
+}
+
+var errShadowsocks2022Removed = errors.New("Shadowsocks 2022 is not included in this build")
