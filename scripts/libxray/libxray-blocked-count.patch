@@ -0,0 +1,51 @@
+package libXray
+
+// ProxysVPN (scripts/libxray/libxray-blocked-count.patch): the shape of
+// "blockedCount" as the PacketTunnel extension reads it.
+
+import (
+	"encoding/json"
+	"testing"
+
+	"github.com/xtls/libxray/xray"
+)
+
+const blockedCountInvokeConfig = `{
+  "log": {"loglevel": "none"},
+  "outbounds": [
+    {"protocol": "freedom", "tag": "direct"},
+    {"protocol": "blackhole", "tag": "ads"}
+  ]
+}`
+
+func TestProxysVPNInvokeBlockedCount(t *testing.T) {
+	if response := invokeForTest(t, LibXrayMethodBlockedCount, BlockedCountRequest{Tag: "ads"}); response.Success || response.Err != xray.ErrNotRunning.Error() {
+		t.Fatalf("no engine: %+v", response)
+	}
+	if err := xray.RunXray(blockedCountInvokeConfig); err != nil {
+		t.Fatal(err)
+	}
+	defer xrayStopForTest(t)
+
+	response := invokeForTest(t, LibXrayMethodBlockedCount, BlockedCountRequest{Tag: "ads"})
+	if !response.Success {
+		t.Fatalf("blockedCount failed: %s", response.Err)
+	}
+	// The count is always there, 0 included.
+	if string(response.Data) != `{"count":0}` {
+		t.Fatalf("data %s, want {\"count\":0}", response.Data)
+	}
+	var data BlockedCountResponse
+	if err := json.Unmarshal(response.Data, &data); err != nil || data.Count != 0 {
+		t.Fatalf("data %s: %v", response.Data, err)
+	}
+
+	for _, request := range []BlockedCountRequest{{}, {Tag: "direct"}, {Tag: "none"}} {
+		if response := invokeForTest(t, LibXrayMethodBlockedCount, request); response.Success || response.Err == "" {
+			t.Fatalf("tag %q: %+v, want an error", request.Tag, response)
+		}
+	}
+	if response := Invoke(`{"apiVersion":3,"method":"blockedCount","payload":{"tag":7}}`); response == "" || response[:17] != `{"success":false,` {
+		t.Fatalf("a tag that is not a string: %s", response)
+	}
+}
