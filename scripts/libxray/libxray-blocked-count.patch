diff --git a/invoke_blocked_count_proxysvpn.go b/invoke_blocked_count_proxysvpn.go
new file mode 100644
--- /dev/null
+++ b/invoke_blocked_count_proxysvpn.go
@@ -0,0 +1,35 @@
+package libXray
+
+// ProxysVPN (scripts/libxray/libxray-blocked-count.patch): "blockedCount"
+// reads how many connections a blackhole outbound of the running engine has
+// received (Xray-core: xray-core-blocked-count.patch). The PacketTunnel
+// extension polls it in process for its count of blocked ads and trackers;
+// nothing listens anywhere for it.
+
+import (
+	"encoding/json"
+
+	"github.com/xtls/libxray/xray"
+)
+
+type BlockedCountRequest struct {
+	// The tag of a blackhole outbound in the running configuration.
+	Tag string `json:"tag,omitempty"`
+}
+
+type BlockedCountResponse struct {
+	// Connections received since the engine started; 0 is a count too.
+	Count int64 `json:"count"`
+}
+
+func invokeBlockedCount(payload json.RawMessage) string {
+	request, err := decodePayload[BlockedCountRequest](payload)
+	if err != nil {
+		return encodeInvokeResponse(nil, err)
+	}
+	count, err := xray.BlockedCount(request.Tag)
+	if err != nil {
+		return encodeInvokeResponse(nil, err)
+	}
+	return encodeInvokeResponse(&BlockedCountResponse{Count: count}, nil)
+}
