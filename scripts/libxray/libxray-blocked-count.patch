diff --git a/xray/blocked_count_proxysvpn.go b/xray/blocked_count_proxysvpn.go
new file mode 100644
--- /dev/null
+++ b/xray/blocked_count_proxysvpn.go
@@ -0,0 +1,44 @@
+package xray
+
+// ProxysVPN (scripts/libxray/libxray-blocked-count.patch): the count of
+// connections a blackhole outbound of the running engine has received, for
+// the app's count of blocked ads and trackers. In process only.
+
+import (
+	"errors"
+
+	"github.com/xtls/xray-core/features/outbound"
+	"github.com/xtls/xray-core/proxy/blackhole"
+)
+
+// Longer than any tag the app writes; a bound on what a caller can pass in.
+const maxBlockedCountTagBytes = 256
+
+var (
+	ErrNotRunning     = errors.New("xray is not running")
+	ErrBadBlockedTag  = errors.New("tag must be 1 to 256 bytes")
+	ErrNoBlackholeTag = errors.New("no blackhole outbound has this tag")
+)
+
+// BlockedCount is how many connections (TCP streams and UDP flows) the
+// blackhole outbound tagged tag has received since the engine started. A
+// stopped and started engine counts from 0 again.
+func BlockedCount(tag string) (int64, error) {
+	if tag == "" || len(tag) > maxBlockedCountTagBytes {
+		return 0, ErrBadBlockedTag
+	}
+	coreServerMu.Lock()
+	defer coreServerMu.Unlock()
+	if coreServer == nil {
+		return 0, ErrNotRunning
+	}
+	manager, ok := coreServer.GetFeature(outbound.ManagerType()).(outbound.Manager)
+	if !ok {
+		return 0, ErrNoBlackholeTag
+	}
+	count, ok := blackhole.BlockedOf(manager, tag)
+	if !ok {
+		return 0, ErrNoBlackholeTag
+	}
+	return count, nil
+}
diff --git a/xray/blocked_count_proxysvpn_test.go b/xray/blocked_count_proxysvpn_test.go
new file mode 100644
--- /dev/null
+++ b/xray/blocked_count_proxysvpn_test.go
@@ -0,0 +1,101 @@
+package xray
+
+// ProxysVPN (scripts/libxray/libxray-blocked-count.patch): BlockedCount reads
+// the count of the running engine by tag, refuses what it cannot read, and
+// starts from 0 with a new engine.
+
+import (
+	"context"
+	"errors"
+	"strings"
+	"testing"
+	"time"
+
+	"github.com/xtls/xray-core/common/net"
+	"github.com/xtls/xray-core/core"
+)
+
+const blockedCountConfig = `{
+  "log": {"loglevel": "none"},
+  "outbounds": [
+    {"protocol": "freedom", "tag": "direct"},
+    {"protocol": "blackhole", "tag": "ads"},
+    {"protocol": "blackhole", "tag": "block"}
+  ],
+  "routing": {"rules": [
+    {"type": "field", "domain": ["full:ads.test"], "outboundTag": "ads"}
+  ]}
+}`
+
+func blockedCountDial(t *testing.T, ctx context.Context, dest net.Destination) {
+	t.Helper()
+	coreServerMu.Lock()
+	server := coreServer
+	coreServerMu.Unlock()
+	conn, err := core.Dial(ctx, server, dest)
+	if err != nil {
+		t.Fatal(err)
+	}
+	t.Cleanup(func() { conn.Close() })
+}
+
+func blockedCountWait(t *testing.T, tag string, want int64) {
+	t.Helper()
+	deadline := time.Now().Add(5 * time.Second)
+	for {
+		got, err := BlockedCount(tag)
+		if err == nil && got == want {
+			return
+		}
+		if time.Now().After(deadline) {
+			t.Fatalf("%q: %d blocked (%v), want %d", tag, got, err, want)
+		}
+		time.Sleep(10 * time.Millisecond)
+	}
+}
+
+func TestProxysVPNBlockedCount(t *testing.T) {
+	if _, err := BlockedCount("ads"); !errors.Is(err, ErrNotRunning) {
+		t.Fatalf("no engine: %v, want %v", err, ErrNotRunning)
+	}
+	if err := RunXray(blockedCountConfig); err != nil {
+		t.Fatal(err)
+	}
+	t.Cleanup(func() { StopXray() })
+	ctx, cancel := context.WithCancel(context.Background())
+	t.Cleanup(cancel)
+
+	for _, c := range []struct {
+		tag  string
+		want error
+	}{
+		{"", ErrBadBlockedTag},
+		{strings.Repeat("a", maxBlockedCountTagBytes+1), ErrBadBlockedTag},
+		{"direct", ErrNoBlackholeTag},
+		{"none", ErrNoBlackholeTag},
+	} {
+		if _, err := BlockedCount(c.tag); !errors.Is(err, c.want) {
+			t.Fatalf("tag of %d bytes: %v, want %v", len(c.tag), err, c.want)
+		}
+	}
+	blockedCountWait(t, "ads", 0)
+	blockedCountWait(t, "block", 0)
+
+	blockedCountDial(t, ctx, net.TCPDestination(net.DomainAddress("ads.test"), 443))
+	blockedCountDial(t, ctx, net.TCPDestination(net.DomainAddress("ads.test"), 80))
+	blockedCountDial(t, ctx, net.UDPDestination(net.DomainAddress("ads.test"), 443))
+	blockedCountWait(t, "ads", 3)
+	blockedCountWait(t, "block", 0)
+
+	cancel()
+	if err := StopXray(); err != nil {
+		t.Fatal(err)
+	}
+	if _, err := BlockedCount("ads"); !errors.Is(err, ErrNotRunning) {
+		t.Fatalf("stopped engine: %v, want %v", err, ErrNotRunning)
+	}
+	if err := RunXray(blockedCountConfig); err != nil {
+		t.Fatal(err)
+	}
+	blockedCountWait(t, "ads", 0)
+}
