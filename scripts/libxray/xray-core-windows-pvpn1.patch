diff --git a/common/net/process_table_cache.go b/common/net/process_table_cache.go
new file mode 100644
index 0000000..bead476
--- /dev/null
+++ b/common/net/process_table_cache.go
@@ -0,0 +1,165 @@
+package net
+
+import (
+	"sync"
+	"time"
+)
+
+// The `process` condition of a routing rule asks the system for its whole
+// connection table on every call: once per rule with such a condition, for
+// every new connection. On Windows that is a blocking system call, and Go
+// gives each goroutine blocked in one its own OS thread. A burst of new UDP
+// flows through the TUN inbound made thousands of threads at once and ended
+// the process at Go's limit of 10000 ("fatal error: thread exhaustion").
+//
+// tableCache lets every lookup that starts while a copy of a table is being
+// taken share that copy, and keeps the last copy for a short while: at most
+// one system call per table runs at a time, whatever the number of
+// connections being routed.
+
+// tableFreshFor is how long a copy of a table answers lookups by itself. A
+// connection opened after the copy was taken is not in it; that lookup misses
+// and asks for a copy begun after the lookup started (find).
+const tableFreshFor = 200 * time.Millisecond
+
+type tableCopy struct {
+	taken time.Time // when the system call that made it began
+	table []byte
+}
+
+type tableFlight struct {
+	started time.Time
+	done    chan struct{}
+	table   []byte
+	err     error
+}
+
+type tableCache struct {
+	mu      sync.Mutex
+	copies  map[int]tableCopy
+	flights map[int]*tableFlight
+	now     func() time.Time
+}
+
+func newTableCache(now func() time.Time) *tableCache {
+	return &tableCache{copies: map[int]tableCopy{}, flights: map[int]*tableFlight{}, now: now}
+}
+
+// get returns a copy of table `key` begun no earlier than `since`. It takes
+// one with `fetch` only when no such copy is kept or being taken; callers that
+// arrive while one is being taken wait for it. The table is shared and must
+// only be read.
+func (c *tableCache) get(key int, since time.Time, fetch func() ([]byte, error)) ([]byte, error) {
+	for {
+		c.mu.Lock()
+		if kept, ok := c.copies[key]; ok && !kept.taken.Before(since) {
+			c.mu.Unlock()
+			return kept.table, nil
+		}
+		if flight := c.flights[key]; flight != nil {
+			c.mu.Unlock()
+			<-flight.done
+			if !flight.started.Before(since) {
+				return flight.table, flight.err
+			}
+			// That copy began before this caller asked: wait for a newer one.
+			continue
+		}
+		flight := &tableFlight{started: c.now(), done: make(chan struct{})}
+		c.flights[key] = flight
+		c.mu.Unlock()
+
+		flight.table, flight.err = fetch()
+
+		c.mu.Lock()
+		delete(c.flights, key)
+		if flight.err == nil {
+			if kept, ok := c.copies[key]; !ok || kept.taken.Before(flight.started) {
+				c.copies[key] = tableCopy{taken: flight.started, table: flight.table}
+			}
+		}
+		c.mu.Unlock()
+		close(flight.done)
+		return flight.table, flight.err
+	}
+}
+
+// find runs `search` over a recent copy of table `key`, and once more over a
+// copy begun after this call when the recent one does not hold the
+// connection: a connection that existed when the lookup began is always in
+// such a copy.
+func (c *tableCache) find(key int, fetch func() ([]byte, error), search func([]byte) (uint32, error)) (uint32, error) {
+	asked := c.now()
+	table, err := c.get(key, asked.Add(-tableFreshFor), fetch)
+	if err != nil {
+		return 0, err
+	}
+	if pid, err := search(table); err == nil {
+		return pid, nil
+	}
+	table, err = c.get(key, asked, fetch)
+	if err != nil {
+		return 0, err
+	}
+	return search(table)
+}
+
+// pathFreshFor is how long the path of a process is kept. Every lookup used
+// to open the process and ask for its path again. A process id reused by
+// another program within this time would still give the old path, which is
+// why it is short.
+const pathFreshFor = time.Second
+
+// pathsKept bounds the paths kept; older ones are dropped beyond it.
+const pathsKept = 1024
+
+type pathEntry struct {
+	path  string
+	taken time.Time
+}
+
+type pathCache struct {
+	mu    sync.Mutex
+	paths map[uint32]pathEntry
+	slots chan struct{}
+	now   func() time.Time
+}
+
+// newPathCache keeps paths for pathFreshFor and lets at most `parallel`
+// lookups of a path run at once; the rest wait for a slot without holding an
+// OS thread.
+func newPathCache(parallel int, now func() time.Time) *pathCache {
+	return &pathCache{paths: map[uint32]pathEntry{}, slots: make(chan struct{}, parallel), now: now}
+}
+
+func (c *pathCache) get(pid uint32, lookup func(uint32) (string, error)) (string, error) {
+	c.mu.Lock()
+	if kept, ok := c.paths[pid]; ok && c.now().Sub(kept.taken) <= pathFreshFor {
+		c.mu.Unlock()
+		return kept.path, nil
+	}
+	c.mu.Unlock()
+
+	c.slots <- struct{}{}
+	taken := c.now()
+	path, err := lookup(pid)
+	<-c.slots
+	if err != nil {
+		return "", err
+	}
+
+	c.mu.Lock()
+	if len(c.paths) >= pathsKept {
+		for id, kept := range c.paths {
+			if taken.Sub(kept.taken) > pathFreshFor {
+				delete(c.paths, id)
+			}
+		}
+		if len(c.paths) >= pathsKept {
+			clear(c.paths)
+		}
+	}
+	c.paths[pid] = pathEntry{path: path, taken: taken}
+	c.mu.Unlock()
+	return path, nil
+}
diff --git a/common/net/process_table_cache_test.go b/common/net/process_table_cache_test.go
new file mode 100644
index 0000000..5aa85c5
--- /dev/null
+++ b/common/net/process_table_cache_test.go
@@ -0,0 +1,261 @@
+package net
+
+import (
+	"errors"
+	"sync"
+	"sync/atomic"
+	"testing"
+	"time"
+)
+
+type fakeClock struct {
+	mu sync.Mutex
+	t  time.Time
+}
+
+func newFakeClock() *fakeClock { return &fakeClock{t: time.Unix(1_700_000_000, 0)} }
+
+func (c *fakeClock) now() time.Time {
+	c.mu.Lock()
+	defer c.mu.Unlock()
+	return c.t
+}
+
+func (c *fakeClock) advance(d time.Duration) {
+	c.mu.Lock()
+	c.t = c.t.Add(d)
+	c.mu.Unlock()
+}
+
+// table is a fake connection table: one byte per connection, its port.
+func searchPort(port byte) func([]byte) (uint32, error) {
+	return func(table []byte) (uint32, error) {
+		for _, p := range table {
+			if p == port {
+				return uint32(p) + 1000, nil
+			}
+		}
+		return 0, errors.New("not found")
+	}
+}
+
+func TestABurstOfLookupsSharesOneSystemCall(t *testing.T) {
+	cache := newTableCache(time.Now)
+	var calls atomic.Int32
+	release := make(chan struct{})
+	fetch := func() ([]byte, error) {
+		calls.Add(1)
+		<-release
+		return []byte{1, 2, 3}, nil
+	}
+
+	const burst = 500
+	var wg sync.WaitGroup
+	errs := make(chan error, burst)
+	for i := 0; i < burst; i++ {
+		wg.Add(1)
+		go func() {
+			defer wg.Done()
+			pid, err := cache.find(0, fetch, searchPort(2))
+			if err == nil && pid != 1002 {
+				err = errors.New("wrong pid")
+			}
+			if err != nil {
+				errs <- err
+			}
+		}()
+	}
+	// Let the burst pile up behind the first copy, then let it finish.
+	time.Sleep(50 * time.Millisecond)
+	close(release)
+	wg.Wait()
+	close(errs)
+	for err := range errs {
+		t.Fatal(err)
+	}
+	if got := calls.Load(); got != 1 {
+		t.Fatalf("%d system calls for one burst, want 1", got)
+	}
+}
+
+func TestAKeptCopyAnswersOnlyWhileFresh(t *testing.T) {
+	clock := newFakeClock()
+	cache := newTableCache(clock.now)
+	calls := 0
+	fetch := func() ([]byte, error) {
+		calls++
+		return []byte{7}, nil
+	}
+	for i := 0; i < 3; i++ {
+		if _, err := cache.find(0, fetch, searchPort(7)); err != nil {
+			t.Fatal(err)
+		}
+		clock.advance(tableFreshFor / 4)
+	}
+	if calls != 1 {
+		t.Fatalf("%d calls within the fresh time, want 1", calls)
+	}
+	clock.advance(tableFreshFor)
+	if _, err := cache.find(0, fetch, searchPort(7)); err != nil {
+		t.Fatal(err)
+	}
+	if calls != 2 {
+		t.Fatalf("%d calls after the fresh time, want 2", calls)
+	}
+}
+
+func TestAMissAsksForACopyBegunAfterTheLookup(t *testing.T) {
+	clock := newFakeClock()
+	cache := newTableCache(clock.now)
+	tables := [][]byte{{1}, {1, 9}}
+	calls := 0
+	fetch := func() ([]byte, error) {
+		table := tables[calls]
+		calls++
+		return table, nil
+	}
+	if _, err := cache.find(0, fetch, searchPort(1)); err != nil {
+		t.Fatal(err)
+	}
+	// A connection opened after that copy: the kept copy is still fresh but
+	// does not hold it, so one more copy is taken.
+	clock.advance(time.Millisecond)
+	pid, err := cache.find(0, fetch, searchPort(9))
+	if err != nil {
+		t.Fatal(err)
+	}
+	if pid != 1009 || calls != 2 {
+		t.Fatalf("pid %d after %d calls, want 1009 after 2", pid, calls)
+	}
+	// A connection in no table: one fresh copy, then "not found".
+	clock.advance(time.Millisecond)
+	tables = append(tables, []byte{1, 9})
+	if _, err := cache.find(0, fetch, searchPort(5)); err == nil {
+		t.Fatal("found a connection in no table")
+	}
+	if calls != 3 {
+		t.Fatalf("%d calls, want 3", calls)
+	}
+}
+
+func TestTablesAreKeptApart(t *testing.T) {
+	clock := newFakeClock()
+	cache := newTableCache(clock.now)
+	tcp := func() ([]byte, error) { return []byte{1}, nil }
+	udp := func() ([]byte, error) { return []byte{2}, nil }
+	if _, err := cache.find(1, tcp, searchPort(1)); err != nil {
+		t.Fatal(err)
+	}
+	if _, err := cache.find(2, udp, searchPort(2)); err != nil {
+		t.Fatal(err)
+	}
+	if _, err := cache.find(1, tcp, searchPort(2)); err == nil {
+		t.Fatal("a port of table 2 was found in table 1")
+	}
+}
+
+func TestAFailedCopyIsReportedAndNotKept(t *testing.T) {
+	clock := newFakeClock()
+	cache := newTableCache(clock.now)
+	fail := errors.New("syscall error: 87")
+	calls := 0
+	fetch := func() ([]byte, error) {
+		calls++
+		if calls == 1 {
+			return nil, fail
+		}
+		return []byte{3}, nil
+	}
+	if _, err := cache.find(0, fetch, searchPort(3)); !errors.Is(err, fail) {
+		t.Fatalf("got %v, want the system call's error", err)
+	}
+	if _, err := cache.find(0, fetch, searchPort(3)); err != nil {
+		t.Fatalf("the next lookup did not take a new copy: %v", err)
+	}
+}
+
+func TestPathsAreKeptBrieflyAndLookedUpFewAtATime(t *testing.T) {
+	clock := newFakeClock()
+	cache := newPathCache(2, clock.now)
+	var running, most atomic.Int32
+	var calls atomic.Int32
+	lookup := func(pid uint32) (string, error) {
+		calls.Add(1)
+		n := running.Add(1)
+		for {
+			m := most.Load()
+			if n <= m || most.CompareAndSwap(m, n) {
+				break
+			}
+		}
+		time.Sleep(2 * time.Millisecond)
+		running.Add(-1)
+		return "C:/Games/game.exe", nil
+	}
+
+	var wg sync.WaitGroup
+	for pid := uint32(1); pid <= 40; pid++ {
+		wg.Add(1)
+		go func(pid uint32) {
+			defer wg.Done()
+			if _, err := cache.get(pid, lookup); err != nil {
+				t.Error(err)
+			}
+		}(pid)
+	}
+	wg.Wait()
+	if got := most.Load(); got > 2 {
+		t.Fatalf("%d path lookups at once, want at most 2", got)
+	}
+
+	before := calls.Load()
+	if path, err := cache.get(7, lookup); err != nil || path != "C:/Games/game.exe" {
+		t.Fatalf("kept path: %q %v", path, err)
+	}
+	if calls.Load() != before {
+		t.Fatal("a kept path was looked up again")
+	}
+	clock.advance(pathFreshFor + time.Millisecond)
+	if _, err := cache.get(7, lookup); err != nil {
+		t.Fatal(err)
+	}
+	if calls.Load() != before+1 {
+		t.Fatal("a stale path was not looked up again")
+	}
+}
+
+func TestPathsKeptStayBounded(t *testing.T) {
+	clock := newFakeClock()
+	cache := newPathCache(4, clock.now)
+	lookup := func(uint32) (string, error) { return "p", nil }
+	for pid := uint32(0); pid < 3*pathsKept; pid++ {
+		if _, err := cache.get(pid, lookup); err != nil {
+			t.Fatal(err)
+		}
+	}
+	cache.mu.Lock()
+	kept := len(cache.paths)
+	cache.mu.Unlock()
+	if kept > pathsKept {
+		t.Fatalf("%d paths kept, want at most %d", kept, pathsKept)
+	}
+}
+
+func TestAFailedPathIsNotKept(t *testing.T) {
+	clock := newFakeClock()
+	cache := newPathCache(1, clock.now)
+	calls := 0
+	lookup := func(uint32) (string, error) {
+		calls++
+		if calls == 1 {
+			return "", errors.New("access denied")
+		}
+		return "q", nil
+	}
+	if _, err := cache.get(9, lookup); err == nil {
+		t.Fatal("the error was lost")
+	}
+	if path, err := cache.get(9, lookup); err != nil || path != "q" {
+		t.Fatalf("got %q %v", path, err)
+	}
+}
