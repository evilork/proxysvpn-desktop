@@ -0,0 +1,42 @@
+package router_test
+
+import (
+	"testing"
+
+	. "github.com/xtls/xray-core/app/router"
+	"github.com/xtls/xray-core/common/net"
+)
+
+func TestProcessLookupSourceTakesAnIPv6Source(t *testing.T) {
+	src, err := ProcessLookupSource(net.Network_TCP, net.ParseIP("fd00::2"), net.Port(50000))
+	if err != nil {
+		t.Fatalf("an IPv6 source did not parse: %v", err)
+	}
+	if src.Network != net.Network_TCP || src.Port != 50000 {
+		t.Fatalf("got %v", src)
+	}
+	if src.Address.Family() != net.AddressFamilyIPv6 || !src.Address.IP().Equal(net.ParseIP("fd00::2")) {
+		t.Fatalf("got address %v, want fd00::2 as IPv6", src.Address)
+	}
+}
+
+func TestProcessLookupSourceKeepsIPv4AsItWas(t *testing.T) {
+	for _, ip := range []net.IP{net.ParseIP("10.0.85.2"), net.ParseIP("10.0.85.2").To4()} {
+		src, err := ProcessLookupSource(net.Network_UDP, ip, net.Port(53))
+		if err != nil {
+			t.Fatalf("%v: %v", ip, err)
+		}
+		if src.Network != net.Network_UDP || src.Port != 53 {
+			t.Fatalf("got %v", src)
+		}
+		if src.Address.Family() != net.AddressFamilyIPv4 || src.Address.String() != "10.0.85.2" {
+			t.Fatalf("got address %v, want 10.0.85.2 as IPv4", src.Address)
+		}
+	}
+}
+
+func TestProcessLookupSourceRefusesOtherNetworks(t *testing.T) {
+	if _, err := ProcessLookupSource(net.Network_UNIX, net.ParseIP("10.0.85.2"), net.Port(1)); err == nil {
+		t.Fatal("a unix flow was given a lookup source")
+	}
+}
