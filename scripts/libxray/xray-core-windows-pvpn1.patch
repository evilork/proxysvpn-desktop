diff --git a/proxy/tun/udp_fullcone_test.go b/proxy/tun/udp_fullcone_test.go
new file mode 100644
index 0000000..486b159
--- /dev/null
+++ b/proxy/tun/udp_fullcone_test.go
@@ -0,0 +1,112 @@
+package tun
+
+import (
+	"sync"
+	"testing"
+	"time"
+
+	"github.com/xtls/xray-core/common/net"
+)
+
+// newTestHandler returns a handler whose new flows are handed to the test
+// instead of the dispatcher.
+func newTestHandler(t *testing.T) (*udpConnectionHandler, chan *udpConn) {
+	t.Helper()
+	started := make(chan *udpConn, 1024)
+	handler := newUdpConnectionHandler(
+		func(conn net.Conn, _ net.Destination) { started <- conn.(*udpConn) },
+		func([]byte, net.Destination, net.Destination) error { return nil },
+	)
+	return handler, started
+}
+
+func nextConn(t *testing.T, started chan *udpConn) *udpConn {
+	t.Helper()
+	select {
+	case conn := <-started:
+		return conn
+	case <-time.After(5 * time.Second):
+		t.Fatal("no flow started")
+		return nil
+	}
+}
+
+func TestSecondCloseOfAnOldFlowKeepsTheNewOne(t *testing.T) {
+	handler, started := newTestHandler(t)
+	src := net.UDPDestination(net.ParseAddress("10.0.0.2"), 40000)
+	dst := net.UDPDestination(net.ParseAddress("192.0.2.1"), 53)
+
+	handler.HandlePacket(src, dst, []byte("first"))
+	old := nextConn(t, started)
+	if err := old.Close(); err != nil {
+		t.Fatal(err)
+	}
+
+	handler.HandlePacket(src, dst, []byte("second"))
+	fresh := nextConn(t, started)
+	if fresh == old {
+		t.Fatal("the closed flow was reused")
+	}
+
+	// The old flow's second close must leave the new flow alone.
+	if err := old.Close(); err != nil {
+		t.Fatal(err)
+	}
+	handler.Lock()
+	owner := handler.udpConns[src]
+	handler.Unlock()
+	if owner != fresh {
+		t.Fatal("the second close of the old flow evicted the new one")
+	}
+
+	handler.HandlePacket(src, dst, []byte("third"))
+	buf := make([]byte, 16)
+	for _, want := range []string{"second", "third"} {
+		n, err := fresh.Read(buf)
+		if err != nil {
+			t.Fatalf("read %q: %v", want, err)
+		}
+		if got := string(buf[:n]); got != want {
+			t.Fatalf("got %q, want %q", got, want)
+		}
+	}
+}
+
+func TestPacketsRacingACloseNeverPanic(t *testing.T) {
+	handler, started := newTestHandler(t)
+	dst := net.UDPDestination(net.ParseAddress("192.0.2.1"), 53)
+	const sources = 8
+	const rounds = 2000
+
+	stop := make(chan struct{})
+	var closers sync.WaitGroup
+	closers.Add(1)
+	go func() {
+		defer closers.Done()
+		for {
+			select {
+			case conn := <-started:
+				// Close twice, as the dispatcher does on teardown.
+				_ = conn.Close()
+				_ = conn.Close()
+			case <-stop:
+				return
+			}
+		}
+	}()
+
+	var senders sync.WaitGroup
+	for s := 0; s < sources; s++ {
+		senders.Add(1)
+		go func(port net.Port) {
+			defer senders.Done()
+			src := net.UDPDestination(net.ParseAddress("10.0.0.2"), port)
+			for i := 0; i < rounds; i++ {
+				handler.HandlePacket(src, dst, []byte("x"))
+			}
+		}(net.Port(41000 + s))
+	}
+	senders.Wait()
+	close(stop)
+	closers.Wait()
+}
diff --git a/transport/internet/interface_index_cache.go b/transport/internet/interface_index_cache.go
new file mode 100644
index 0000000..7bc277f
--- /dev/null
+++ b/transport/internet/interface_index_cache.go
@@ -0,0 +1,64 @@
+package internet
+
+import (
+	"net"
+	"sync"
+	"time"
+)
+
+// An outbound bound to an interface (`sockopt.interface`) used to ask the
+// system for the whole adapter list (net.InterfaceByName) for every socket it
+// opened. On Windows that is GetAdaptersAddresses, a slow blocking call, and
+// Go gives each goroutine blocked in one its own OS thread: a burst of new
+// flows through a TUN inbound routed to such an outbound held thousands of
+// threads in it. interfaceIndexCache asks once per name and keeps the answer
+// briefly; while one caller asks, the others wait for its answer.
+
+// interfaceFreshFor is how long the index of a named interface is kept. An
+// adapter that goes away or comes back under a new index is seen after at
+// most this long.
+const interfaceFreshFor = time.Second
+
+type interfaceIndex struct {
+	index int
+	taken time.Time
+}
+
+type interfaceIndexCache struct {
+	mu      sync.Mutex
+	indexes map[string]interfaceIndex
+	now     func() time.Time
+	lookup  func(name string) (int, error)
+}
+
+func newInterfaceIndexCache(now func() time.Time, lookup func(name string) (int, error)) *interfaceIndexCache {
+	return &interfaceIndexCache{indexes: map[string]interfaceIndex{}, now: now, lookup: lookup}
+}
+
+func lookupInterfaceIndex(name string) (int, error) {
+	inf, err := net.InterfaceByName(name)
+	if err != nil {
+		return 0, err
+	}
+	return inf.Index, nil
+}
+
+var outboundInterfaces = newInterfaceIndexCache(time.Now, lookupInterfaceIndex)
+
+// index returns the index of the interface called `name`. The lock is held
+// through the lookup on purpose: callers that arrive meanwhile park on it
+// without an OS thread and then take the fresh answer.
+func (c *interfaceIndexCache) index(name string) (int, error) {
+	c.mu.Lock()
+	defer c.mu.Unlock()
+	if kept, ok := c.indexes[name]; ok && c.now().Sub(kept.taken) <= interfaceFreshFor {
+		return kept.index, nil
+	}
+	index, err := c.lookup(name)
+	if err != nil {
+		delete(c.indexes, name)
+		return 0, err
+	}
+	c.indexes[name] = interfaceIndex{index: index, taken: c.now()}
+	return index, nil
+}
diff --git a/transport/internet/interface_index_cache_test.go b/transport/internet/interface_index_cache_test.go
new file mode 100644
index 0000000..8d745ce
--- /dev/null
+++ b/transport/internet/interface_index_cache_test.go
@@ -0,0 +1,97 @@
+package internet
+
+import (
+	"errors"
+	"sync"
+	"sync/atomic"
+	"testing"
+	"time"
+)
+
+type stepClock struct {
+	mu sync.Mutex
+	t  time.Time
+}
+
+func (c *stepClock) now() time.Time {
+	c.mu.Lock()
+	defer c.mu.Unlock()
+	return c.t
+}
+
+func (c *stepClock) advance(d time.Duration) {
+	c.mu.Lock()
+	c.t = c.t.Add(d)
+	c.mu.Unlock()
+}
+
+func TestABurstOfSocketsAsksForTheInterfaceOnce(t *testing.T) {
+	var calls atomic.Int32
+	cache := newInterfaceIndexCache(time.Now, func(name string) (int, error) {
+		calls.Add(1)
+		time.Sleep(20 * time.Millisecond)
+		return 7, nil
+	})
+	var wg sync.WaitGroup
+	for i := 0; i < 300; i++ {
+		wg.Add(1)
+		go func() {
+			defer wg.Done()
+			if index, err := cache.index("Ethernet"); err != nil || index != 7 {
+				t.Errorf("got %d %v", index, err)
+			}
+		}()
+	}
+	wg.Wait()
+	if got := calls.Load(); got != 1 {
+		t.Fatalf("%d lookups for one burst, want 1", got)
+	}
+}
+
+func TestAnInterfaceIndexIsAskedAgainWhenStale(t *testing.T) {
+	clock := &stepClock{t: time.Unix(1_700_000_000, 0)}
+	next := 3
+	cache := newInterfaceIndexCache(clock.now, func(string) (int, error) { return next, nil })
+	if index, _ := cache.index("Ethernet"); index != 3 {
+		t.Fatalf("got %d, want 3", index)
+	}
+	next = 9
+	clock.advance(interfaceFreshFor / 2)
+	if index, _ := cache.index("Ethernet"); index != 3 {
+		t.Fatalf("a fresh index was asked again: got %d", index)
+	}
+	clock.advance(interfaceFreshFor)
+	if index, _ := cache.index("Ethernet"); index != 9 {
+		t.Fatalf("a stale index was kept: got %d, want 9", index)
+	}
+}
+
+func TestInterfaceNamesAreKeptApart(t *testing.T) {
+	clock := &stepClock{t: time.Unix(1_700_000_000, 0)}
+	cache := newInterfaceIndexCache(clock.now, func(name string) (int, error) { return len(name), nil })
+	if index, _ := cache.index("Ethernet"); index != 8 {
+		t.Fatalf("got %d", index)
+	}
+	if index, _ := cache.index("Wi-Fi"); index != 5 {
+		t.Fatalf("got %d", index)
+	}
+}
+
+func TestAMissingInterfaceIsReportedAndNotKept(t *testing.T) {
+	clock := &stepClock{t: time.Unix(1_700_000_000, 0)}
+	gone := errors.New("route ip+net: no such network interface")
+	calls := 0
+	cache := newInterfaceIndexCache(clock.now, func(string) (int, error) {
+		calls++
+		if calls == 1 {
+			return 0, gone
+		}
+		return 4, nil
+	})
+	if _, err := cache.index("Ethernet"); !errors.Is(err, gone) {
+		t.Fatalf("got %v, want the lookup's error", err)
+	}
+	if index, err := cache.index("Ethernet"); err != nil || index != 4 {
+		t.Fatalf("the next socket did not ask again: %d %v", index, err)
+	}
+}
