diff --git a/proxy/tun/stack_gvisor.go b/proxy/tun/stack_gvisor.go
--- a/proxy/tun/stack_gvisor.go
+++ b/proxy/tun/stack_gvisor.go
@@ -23,13 +23,21 @@
 const (
 	defaultNIC tcpip.NICID = 1
 
+	// ProxysVPN (scripts/libxray/xray-core-tunnel-memory.patch): this build
+	// runs inside an Apple packet tunnel extension, which the system ends at
+	// about 50 MiB for the whole process. Upstream sizes these buffers for a
+	// router: 1 MiB per connection and direction to begin with, and gVisor
+	// then grows them with the flow to 8 MiB and 6 MiB and never shrinks
+	// them. The link they serve here is the device's own utun, a fraction of
+	// a millisecond away, where 512 KiB of window still carries far more
+	// than any uplink delivers.
 	tcpRXBufMinSize = tcp.MinBufferSize
-	tcpRXBufDefSize = tcp.DefaultSendBufferSize
-	tcpRXBufMaxSize = 8 << 20 // 8MiB
+	tcpRXBufDefSize = 128 << 10 // 128KiB
+	tcpRXBufMaxSize = 512 << 10 // 512KiB
 
 	tcpTXBufMinSize = tcp.MinBufferSize
-	tcpTXBufDefSize = tcp.DefaultReceiveBufferSize
-	tcpTXBufMaxSize = 6 << 20 // 6MiB
+	tcpTXBufDefSize = 128 << 10 // 128KiB
+	tcpTXBufMaxSize = 512 << 10 // 512KiB
 )
 
 // stackGVisor is ip stack implemented by gVisor package
