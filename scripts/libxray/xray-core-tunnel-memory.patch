@@ -0,0 +1,78 @@
+package tun
+
+// ProxysVPN (scripts/libxray/xray-core-tunnel-memory.patch): what each TCP
+// connection of the tun stack may hold. The build runs these after patching:
+// an engine for a phone or a TV whose sizes are not the capped ones, or a
+// macOS engine still held to them, does not get built.
+
+import (
+	"runtime"
+	"testing"
+
+	"gvisor.dev/gvisor/pkg/tcpip"
+	"gvisor.dev/gvisor/pkg/tcpip/link/channel"
+	"gvisor.dev/gvisor/pkg/tcpip/transport/tcp"
+)
+
+var (
+	tcpBuffersTestCappedRX = tcpip.TCPReceiveBufferSizeRangeOption{Min: tcp.MinBufferSize, Default: 128 << 10, Max: 512 << 10}
+	tcpBuffersTestCappedTX = tcpip.TCPSendBufferSizeRangeOption{Min: tcp.MinBufferSize, Default: 128 << 10, Max: 512 << 10}
+	// Upstream's own sizes, as Xray-core v26.9.9 sets them.
+	tcpBuffersTestUpstreamRX = tcpip.TCPReceiveBufferSizeRangeOption{Min: tcp.MinBufferSize, Default: tcp.DefaultSendBufferSize, Max: 8 << 20}
+	tcpBuffersTestUpstreamTX = tcpip.TCPSendBufferSizeRangeOption{Min: tcp.MinBufferSize, Default: tcp.DefaultReceiveBufferSize, Max: 6 << 20}
+)
+
+// Every build but macOS's keeps the capped sizes, and an unknown or
+// misspelled GOOS too: a cap that is wrongly on costs speed, one that is
+// wrongly off ends the tunnel.
+func TestProxysVPNTCPBuffersByGOOS(t *testing.T) {
+	for _, c := range []struct {
+		goos   string
+		capped bool
+	}{
+		{"darwin", false},
+		{"ios", true},     // iPhone, iPad, and libXray's tvOS slices
+		{"android", true}, // Android
+		{"linux", true},
+		{"windows", true},
+		{"", true},
+		{"Darwin", true},
+		{"darwin ", true},
+	} {
+		if got := tunnelMemoryCapped(c.goos); got != c.capped {
+			t.Errorf("GOOS %q: capped %v, want %v", c.goos, got, c.capped)
+		}
+		wantRX, wantTX := tcpBuffersTestUpstreamRX, tcpBuffersTestUpstreamTX
+		if c.capped {
+			wantRX, wantTX = tcpBuffersTestCappedRX, tcpBuffersTestCappedTX
+		}
+		rx, tx := tcpBufferSizes(c.goos)
+		if rx != wantRX {
+			t.Errorf("GOOS %q: receive buffers %+v, want %+v", c.goos, rx, wantRX)
+		}
+		if tx != wantTX {
+			t.Errorf("GOOS %q: send buffers %+v, want %+v", c.goos, tx, wantTX)
+		}
+	}
+}
+
+// The stack this engine builds carries the sizes of its own GOOS.
+func TestProxysVPNTCPBuffersOfTheStack(t *testing.T) {
+	ipStack, err := createStack(channel.New(16, 1500, ""))
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer ipStack.Close()
+	var rx tcpip.TCPReceiveBufferSizeRangeOption
+	if err := ipStack.TransportProtocolOption(tcp.ProtocolNumber, &rx); err != nil {
+		t.Fatalf("read the receive buffer sizes: %v", err)
+	}
+	var tx tcpip.TCPSendBufferSizeRangeOption
+	if err := ipStack.TransportProtocolOption(tcp.ProtocolNumber, &tx); err != nil {
+		t.Fatalf("read the send buffer sizes: %v", err)
+	}
+	wantRX, wantTX := tcpBufferSizes(runtime.GOOS)
+	if rx != wantRX || tx != wantTX {
+		t.Fatalf("GOOS %s: the stack receives with %+v and sends with %+v, want %+v and %+v", runtime.GOOS, rx, tx, wantRX, wantTX)
+	}
+}
