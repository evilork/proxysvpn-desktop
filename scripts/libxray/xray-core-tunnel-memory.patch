+// h2StreamReceiveBuffer is how much one HTTP/2 stream may hold for a reader
+// that is slower than the network.
+//
+// ProxysVPN (scripts/libxray/xray-core-tunnel-memory.patch): this build runs
+// inside an Apple packet tunnel extension, which the system ends at about
+// 50 MiB for the whole process. Go's HTTP/2 client lets the server send 4 MiB
+// per stream before the reader has taken a byte, so eight downloads whose app
+// reads slower than the network (a game unpacking what it fetches) hold
+// 32 MiB here, and the tunnel is gone. 512 KiB per stream still carries
+// 40 Mbit/s per stream at 100 ms to the node, and more on a nearer one. The
+// connection's own window stays as it is: a small one would let a few stalled
+// streams stop every other stream that shares the connection.
+const h2StreamReceiveBuffer = 512 << 10
+
+// newH2Transport is the HTTP/2 client of this transport, with the stream
+// window above. The window is a setting of net/http's Transport, which the
+// HTTP/2 one is attached to; requests still go out through dialTLS.
+func newH2Transport(dialTLS func(ctx context.Context, network string, addr string, cfg *gotls.Config) (net.Conn, error), keepAlivePeriod time.Duration) *http2.Transport {
+	h2, err := http2.ConfigureTransports(&http.Transport{
+		HTTP2: &http.HTTP2Config{MaxReceiveBufferPerStream: h2StreamReceiveBuffer},
+	})
+	if err != nil {
+		// Never with the toolchain this build pins; the window is then the
+		// library's own.
+		h2 = &http2.Transport{}
+	}
+	h2.DialTLSContext = dialTLS
+	h2.IdleConnTimeout = net.ConnIdleTimeout
+	h2.ReadIdleTimeout = keepAlivePeriod
+	return h2
 }
 
