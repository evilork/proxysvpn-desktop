+// h2StreamReceiveBuffer is how much one HTTP/2 stream may hold for a reader
+// that is slower than the network, where the memory of the tunnel is capped.
+//
+// ProxysVPN (scripts/libxray/xray-core-tunnel-memory.patch): on an iPhone or
+// an Apple TV this build runs inside a packet tunnel extension, which the
+// system ends at about 50 MiB for the whole process. Go's HTTP/2 client lets
+// the server send 4 MiB per stream before the reader has taken a byte, so
+// eight downloads whose app reads slower than the network (a game unpacking
+// what it fetches) hold 32 MiB here, and the tunnel is gone. 512 KiB per
+// stream still carries 40 Mbit/s per stream at 100 ms to the node, and more
+// on a nearer one. The connection's own window stays as it is: a small one
+// would let a few stalled streams stop every other stream that shares the
+// connection.
+const h2StreamReceiveBuffer = 512 << 10
+
+// h2StreamReceiveBufferFor is the stream window of the engine built for
+// goos: h2StreamReceiveBuffer everywhere but macOS, and on macOS 0, the
+// library's own window, as upstream has it. "darwin" is macOS alone: libXray
+// builds its iOS and tvOS slices with GOOS=ios, and Android's is "android" -
+// every one of those keeps 512 KiB exactly as before macOS was told apart
+// (26.10.2026). A Mac's extension has no 50 MiB limit, and there the small
+// window was only a ceiling on one download: a stream carries at most a
+// window per round trip, 512 KiB in 150 ms to the node is about 28 Mbit/s.
+func h2StreamReceiveBufferFor(goos string) int {
+	if goos == "darwin" {
+		return 0
+	}
+	return h2StreamReceiveBuffer
+}
+
+// newH2Transport is the HTTP/2 client of this transport, with the stream
+// window of this build (h2StreamReceiveBufferFor) and the frame size of
+// h2_frame_size_proxysvpn.go.
+func newH2Transport(dialTLS func(ctx context.Context, network string, addr string, cfg *gotls.Config) (net.Conn, error), keepAlivePeriod time.Duration) *http2.Transport {
+	return newH2TransportWithWindow(dialTLS, keepAlivePeriod, h2StreamReceiveBufferFor(runtime.GOOS))
+}
+
+// newH2TransportWithWindow is newH2Transport with the stream window given:
+// 0 leaves the library's own, as upstream's transport does. The window is a
+// setting of net/http's Transport, which the HTTP/2 one is then attached to;
+// requests still go out through dialTLS.
+func newH2TransportWithWindow(dialTLS func(ctx context.Context, network string, addr string, cfg *gotls.Config) (net.Conn, error), keepAlivePeriod time.Duration, window int) *http2.Transport {
+	h2 := &http2.Transport{}
+	if window > 0 {
+		configured, err := http2.ConfigureTransports(&http.Transport{
+			HTTP2: &http.HTTP2Config{MaxReceiveBufferPerStream: window},
+		})
+		// An error never comes with the toolchain this build pins; the window
+		// is then the library's own.
+		if err == nil {
+			h2 = configured
+		}
+	}
+	h2.DialTLSContext = func(ctx context.Context, network string, addr string, cfg *gotls.Config) (net.Conn, error) {
+		conn, err := dialTLS(ctx, network, addr, cfg)
+		if err != nil {
+			return nil, err
+		}
+		return capH2SendFrameSize(conn), nil
+	}
+	h2.IdleConnTimeout = net.ConnIdleTimeout
+	h2.ReadIdleTimeout = keepAlivePeriod
+	return h2
+}
