diff --git a/transport/internet/splithttp/h2_window_proxysvpn_test.go b/transport/internet/splithttp/h2_window_proxysvpn_test.go
new file mode 100644
--- /dev/null
+++ b/transport/internet/splithttp/h2_window_proxysvpn_test.go
@@ -0,0 +1,91 @@
+package splithttp
+
+// ProxysVPN (scripts/libxray/xray-core-tunnel-memory.patch). The build runs
+// this test after patching: a toolchain or library bump that silently puts the
+// 4 MiB window back, or stops dialing through the transport's own dialer,
+// fails the build instead of ending tunnels on people's phones.
+
+import (
+	"context"
+	gotls "crypto/tls"
+	"io"
+	"net"
+	"net/http"
+	"net/http/httptest"
+	"sync/atomic"
+	"testing"
+	"time"
+)
+
+func TestProxysVPNH2StreamWindow(t *testing.T) {
+	const streams = 8
+	var sent atomic.Int64
+	server := httptest.NewUnstartedServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		chunk := make([]byte, 32<<10)
+		for i := 0; i < 1024; i++ { // 32 MiB per stream, far past any window
+			n, err := w.Write(chunk)
+			sent.Add(int64(n))
+			if err != nil {
+				return
+			}
+			w.(http.Flusher).Flush()
+		}
+	}))
+	server.EnableHTTP2 = true
+	server.StartTLS()
+	defer server.Close()
+
+	var dials atomic.Int32
+	transport := newH2Transport(func(ctx context.Context, network string, addr string, cfg *gotls.Config) (net.Conn, error) {
+		dials.Add(1)
+		return gotls.Dial("tcp", server.Listener.Addr().String(), &gotls.Config{InsecureSkipVerify: true, NextProtos: []string{"h2"}})
+	}, 45*time.Second)
+
+	var responses []*http.Response
+	defer func() {
+		for _, response := range responses {
+			response.Body.Close()
+		}
+	}()
+	for i := 0; i < streams; i++ {
+		request, err := http.NewRequest(http.MethodGet, server.URL, nil)
+		if err != nil {
+			t.Fatal(err)
+		}
+		response, err := transport.RoundTrip(request)
+		if err != nil {
+			t.Fatalf("stream %d: %v", i, err)
+		}
+		if response.ProtoMajor != 2 {
+			t.Fatalf("stream %d spoke %s, not HTTP/2", i, response.Proto)
+		}
+		responses = append(responses, response)
+	}
+	if got := dials.Load(); got != 1 {
+		t.Fatalf("%d streams took %d dials through the transport's dialer, want 1 connection", streams, got)
+	}
+
+	// Nobody reads. The server stops once every stream's window is full.
+	var held int64
+	for settled := 0; settled < 5; {
+		time.Sleep(100 * time.Millisecond)
+		if now := sent.Load(); now == held {
+			settled++
+		} else {
+			held, settled = now, 0
+		}
+	}
+	// A write that had begun when the window closed is counted whole.
+	limit := int64(streams) * (h2StreamReceiveBuffer + 64<<10)
+	if held > limit {
+		t.Fatalf("%d unread streams hold %d KiB, want at most %d KiB (%d KiB per stream)", streams, held>>10, limit>>10, h2StreamReceiveBuffer>>10)
+	}
+	if floor := int64(streams) * h2StreamReceiveBuffer / 2; held < floor {
+		t.Fatalf("%d unread streams hold only %d KiB: the window is smaller than the %d KiB asked for", streams, held>>10, h2StreamReceiveBuffer>>10)
+	}
+
+	// A stream that is read again goes on past its window.
+	if n, err := io.CopyN(io.Discard, responses[0].Body, 2*h2StreamReceiveBuffer); err != nil {
+		t.Fatalf("read %d bytes of a stream that had been waiting: %v", n, err)
+	}
+}
