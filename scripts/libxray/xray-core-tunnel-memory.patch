diff --git a/proxy/tun/restart_proxysvpn_test.go b/proxy/tun/restart_proxysvpn_test.go
new file mode 100644
--- /dev/null
+++ b/proxy/tun/restart_proxysvpn_test.go
@@ -0,0 +1,185 @@
+//go:build darwin
+
+package tun_test
+
+// ProxysVPN (scripts/libxray/xray-core-tunnel-memory.patch). The packet
+// tunnel extension restarts the engine in place when memory runs out
+// (MemoryGuard.swift): it stops Xray and starts it again in the same process
+// on a new duplicate of the same utun descriptor, while the apps keep
+// sending. This is that sequence on a socket pair standing in for the utun.
+// It fails if a new Xray-core no longer comes back from it - the extension
+// would then hold a tunnel that carries nothing.
+
+import (
+	"fmt"
+	"runtime/debug"
+	"strings"
+	"testing"
+	"time"
+
+	"github.com/xtls/xray-core/core"
+	_ "github.com/xtls/xray-core/main/distro/all"
+	"golang.org/x/sys/unix"
+	"gvisor.dev/gvisor/pkg/tcpip"
+	"gvisor.dev/gvisor/pkg/tcpip/checksum"
+	"gvisor.dev/gvisor/pkg/tcpip/header"
+)
+
+var (
+	proxysvpnApp  = tcpip.AddrFrom4([4]byte{10, 111, 0, 2})
+	proxysvpnSite = tcpip.AddrFrom4([4]byte{198, 51, 100, 7})
+)
+
+// A SYN from an app behind the tunnel, as the utun hands it over.
+func proxysvpnSyn(srcPort uint16) []byte {
+	const ipLen = header.IPv4MinimumSize + header.TCPMinimumSize
+	p := make([]byte, 4+ipLen)
+	p[3] = unix.AF_INET
+	ip := header.IPv4(p[4:])
+	ip.Encode(&header.IPv4Fields{
+		TotalLength: ipLen, TTL: 64, Protocol: uint8(header.TCPProtocolNumber),
+		SrcAddr: proxysvpnApp, DstAddr: proxysvpnSite,
+	})
+	ip.SetChecksum(^ip.CalculateChecksum())
+	tcp := header.TCP(p[4+header.IPv4MinimumSize:])
+	tcp.Encode(&header.TCPFields{
+		SrcPort: srcPort, DstPort: 443, SeqNum: 1000, DataOffset: header.TCPMinimumSize,
+		Flags: header.TCPFlagSyn, WindowSize: 65535,
+	})
+	sum := header.PseudoHeaderChecksum(header.TCPProtocolNumber, proxysvpnApp, proxysvpnSite, header.TCPMinimumSize)
+	tcp.SetChecksum(^checksum.Checksum(tcp, sum))
+	return p
+}
+
+// Whether the engine answers the SYN from srcPort within the wait.
+func proxysvpnSynAcked(far int, srcPort uint16, wait time.Duration) bool {
+	deadline := time.Now().Add(wait)
+	buf := make([]byte, 2048)
+	for time.Now().Before(deadline) {
+		fds := []unix.PollFd{{Fd: int32(far), Events: unix.POLLIN}}
+		if n, _ := unix.Poll(fds, 50); n <= 0 {
+			continue
+		}
+		n, err := unix.Read(far, buf)
+		if err != nil || n < 4+header.IPv4MinimumSize+header.TCPMinimumSize {
+			continue
+		}
+		ip := header.IPv4(buf[4:n])
+		if ip.Protocol() != uint8(header.TCPProtocolNumber) {
+			continue
+		}
+		tcp := header.TCP(ip.Payload())
+		if tcp.DestinationPort() == srcPort && tcp.Flags() == header.TCPFlagSyn|header.TCPFlagAck {
+			return true
+		}
+	}
+	return false
+}
+
+// The engine on a duplicate of the tunnel's descriptor, started the way
+// libXray's RunXray starts it.
+func proxysvpnStart(t *testing.T, own int) *core.Instance {
+	t.Helper()
+	fd, err := unix.Dup(own)
+	if err != nil {
+		t.Fatal(err)
+	}
+	text := fmt.Sprintf(`{"log":{"loglevel":"none"},"env":{"xray.tun.fd":"%d"},
+		"inbounds":[{"tag":"tun-in","protocol":"tun","settings":{"name":"utun","mtu":1500}}],
+		"outbounds":[{"protocol":"freedom","tag":"direct"}]}`, fd)
+	config, err := core.LoadConfig("json", strings.NewReader(text))
+	if err != nil {
+		t.Fatal(err)
+	}
+	server, err := core.New(config)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if err := server.Start(); err != nil {
+		t.Fatal(err)
+	}
+	debug.FreeOSMemory()
+	return server
+}
+
+func TestProxysVPNRestartOnTheSameTunnel(t *testing.T) {
+	pair, err := unix.Socketpair(unix.AF_UNIX, unix.SOCK_DGRAM, 0)
+	if err != nil {
+		t.Fatal(err)
+	}
+	own, far := pair[0], pair[1]
+	defer unix.Close(own)
+	defer unix.Close(far)
+
+	first := proxysvpnStart(t, own)
+	unix.Write(far, proxysvpnSyn(40001))
+	if !proxysvpnSynAcked(far, 40001, 3*time.Second) {
+		t.Fatal("the engine did not answer a SYN from the tunnel")
+	}
+
+	// The apps keep sending while the engine is replaced: the guard fires
+	// under load, so the old reader is busy, not waiting.
+	stop := make(chan struct{})
+	sent := make(chan struct{})
+	go func() {
+		defer close(sent)
+		for port := uint16(20000); ; port++ {
+			select {
+			case <-stop:
+				return
+			default:
+				unix.Write(far, proxysvpnSyn(port))
+				time.Sleep(time.Millisecond)
+			}
+		}
+	}()
+	// Nobody reads the answers to that traffic; a full socket must not stall
+	// the engine's writes.
+	drained := make(chan struct{})
+	go func() {
+		defer close(drained)
+		buf := make([]byte, 2048)
+		for {
+			select {
+			case <-stop:
+				return
+			default:
+				fds := []unix.PollFd{{Fd: int32(far), Events: unix.POLLIN}}
+				if n, _ := unix.Poll(fds, 20); n > 0 {
+					unix.Read(far, buf)
+				}
+			}
+		}
+	}()
+
+	time.Sleep(200 * time.Millisecond)
+	if err := first.Close(); err != nil {
+		t.Fatalf("the engine did not stop: %v", err)
+	}
+	first = nil
+	second := proxysvpnStart(t, own)
+	defer second.Close()
+
+	// What libXray does once a second on iOS: whatever the stopped engine
+	// left behind is collected, the descriptor it was handed included.
+	for i := 0; i < 8; i++ {
+		time.Sleep(250 * time.Millisecond)
+		debug.FreeOSMemory()
+	}
+	close(stop)
+	<-sent
+	<-drained
+
+	if _, err := unix.FcntlInt(uintptr(own), unix.F_GETFD, 0); err != nil {
+		t.Fatalf("the tunnel's own descriptor did not outlive the first engine: %v", err)
+	}
+	// A reader of the stopped engine may take one packet before it leaves;
+	// the system's TCP sends a SYN again, and so does this.
+	for attempt := uint16(1); attempt <= 4; attempt++ {
+		unix.Write(far, proxysvpnSyn(41000+attempt))
+		if proxysvpnSynAcked(far, 41000+attempt, 2*time.Second) {
+			return
+		}
+	}
+	t.Fatal("the restarted engine does not answer a SYN from the tunnel")
+}
