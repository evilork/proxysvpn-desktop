# Node
node_modules/
dist/

# Rust / Tauri
src-tauri/target/
src-tauri/Cargo.lock

# The iOS project under src-tauri/gen is almost entirely generated - by
# `tauri ios init`, by xcodegen out of project.yml, and by the build. Almost:
# PacketTunnelProvider.swift is 361 lines written by hand, project.yml is what
# xcodegen generates FROM, and without them `scripts/setup-ios.sh` has nothing
# to work with on a fresh clone. So the folder is ignored and those are
# excepted, rather than the whole thing being dropped.
src-tauri/gen/*
!src-tauri/gen/apple/
src-tauri/gen/apple/*
!src-tauri/gen/apple/project.yml
!src-tauri/gen/apple/ExportOptions.plist
!src-tauri/gen/apple/PacketTunnel/
src-tauri/gen/apple/PacketTunnel/*
!src-tauri/gen/apple/PacketTunnel/PacketTunnelProvider.swift

# IDE
.vscode/
.idea/
.DS_Store

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Build outputs
*.dmg
*.msi
*.AppImage
*.deb

# Large binaries — fetched separately by scripts/fetch-binaries.sh
src-tauri/binaries/xray-*
src-tauri/binaries/geoip.dat
src-tauri/binaries/geosite.dat

# Large binaries — fetched separately by scripts/fetch-binaries.sh

# Sidecar binaries — fetched via scripts/fetch-binaries.sh (do not commit)
src-tauri/binaries/tun2socks-*

# Local backups from patch scripts
*.bak
*.bak2

# Internal devscripts (not for public repo)
apply.py
INSTRUCTIONS.txt
src-tauri/scripts/bench-configs.sh

# Build/release temp
scripts/release-templates/
src-tauri/binaries/hysteria-*
