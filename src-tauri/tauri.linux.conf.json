{
  "$schema": "https://schema.tauri.app/config/2",
  "build": {
    "beforeBundleCommand": "cargo build --release --locked --manifest-path src-tauri/Cargo.toml -p pvpn-platform --bin proxysvpn-helper"
  },
  "bundle": {
    "targets": ["deb", "appimage"],
    "category": "Utility",
    "shortDescription": "ProxysVPN desktop client",
    "longDescription": "Desktop client for the ProxysVPN service: routes the system's traffic through a VLESS or Hysteria2 node with split routing. Remove with: sudo apt remove proxys-vpn",
    "homepage": "https://proxysvpn.com",
    "linux": {
      "appimage": {
        "bundleMediaFramework": false,
        "files": {
          "/usr/bin/proxysvpn-helper": "target/release/proxysvpn-helper",
          "/usr/share/doc/proxysvpn-desktop/LGPL-SOURCES.txt": "linux/LGPL-SOURCES.txt"
        }
      },
      "deb": {
        "section": "net",
        "postRemoveScript": "linux/postrm",
        "depends": [
          "libwebkit2gtk-4.1-0",
          "libgtk-3-0",
          "iproute2",
          "pkexec | policykit-1",
          "libayatana-appindicator3-1 | libappindicator3-1"
        ],
        "files": {
          "/usr/share/polkit-1/actions/com.proxysvpn.desktop.policy": "linux/com.proxysvpn.desktop.policy"
        }
      }
    }
  }
}
